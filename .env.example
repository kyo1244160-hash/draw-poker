# =============================================================
# Poker Room Pastis — 環境変数テンプレート
# このファイルを .env.local にコピーして値を設定してください。
# .env.local は .gitignore に含まれており git push されません。
# =============================================================

# ----- Supabase (PostgreSQL) -----
# Supabase Dashboard > Connect > Session pooler の URI をコピー
# ※ Transaction pooler (port 6543) は Render（IPv4 のみ）では使用不可
DATABASE_URL=

# ----- Google OAuth -----
# https://console.cloud.google.com/apis/credentials で取得
# リダイレクト URI に以下を両方登録すること:
#   http://localhost:3000/api/auth/callback/google       (開発用)
#   https://draw-poker.onrender.com/api/auth/callback/google  (本番用)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- NextAuth.js -----
# 生成コマンド:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# 開発環境
NEXTAUTH_URL=http://localhost:3000
# 本番環境 → Render の環境変数で上書き
# NEXTAUTH_URL=https://draw-poker.onrender.com

# ----- Socket.IO CORS -----
# NEXTAUTH_URL と同じ値を設定する
ALLOWED_ORIGIN=http://localhost:3000
# 本番環境 → Render の環境変数で上書き
# ALLOWED_ORIGIN=https://draw-poker.onrender.com

# ----- BOT 認証 -----
# サーバー内部の BOT が Socket.IO 認証をバイパスするための共有シークレット
# 本番では推測されにくい文字列に変更すること
BOT_SECRET=replace-with-a-strong-random-secret

# ----- サーバー -----
# Render は PORT=10000 を自動設定するため、通常は設定不要
# PORT=3000
